{
  "functions": {
    "api/admin/index.js": {
      "maxDuration": 60,
      "includeFiles": "scripts/migrations/**"
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/admin/index?path=$1"
    },
    {
      "source": "/form/:slug",
      "destination": "/form?slug=:slug"
    },
    {
      "source": "/api/forms/:slug/submit",
      "destination": "/api/forms/:slug"
    },
    {
      "source": "/parceiros/:slug",
      "destination": "/parceiros-perfil?slug=:slug"
    },
    {
      "source": "/go/:slug/:channel",
      "destination": "/api/partners/go?slug=:slug&channel=:channel"
    },
    {
      "source": "/sitemap-parceiros.xml",
      "destination": "/api/partners/sitemap"
    },
    {
      "source": "/api/telao/:job",
      "destination": "/api/telao?job=:job"
    }
  ],
  "crons": [
    {
      "path": "/api/partners/jobs/tick",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/telao/tick",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/telao/daily",
      "schedule": "5 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/favicon.ico",
      "permanent": true
    },
    {
      "source": "/aulas",
      "destination": "/planos",
      "permanent": false
    },
    {
      "source": "/estudio",
      "destination": "/planos",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "antonovcenter.com.br" }],
      "destination": "https://www.antonovcenter.com.br/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
